---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageTitle from '../../components/PageTitle.astro';
import { getAllPosts, getPosts, readNext, readingTime, description, type Post } from '../../lib/posts';
import { formatDateTime, ui } from '../../lib/i18n';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const { lang } = post.data;
const t = ui[lang];
const next = readNext(post, await getPosts());
---

<Base title={post.data.title} description={description(post)} type="article" lang={lang} cover={post.data.cover} coverAlt={post.data.coverAlt}>
  <PageTitle title={post.data.title}>
    <div class="meta">
      <span class="date">{t.created}: {formatDateTime(post.data.createdAt, lang)} · {t.readingTime(readingTime(post))}</span>
    </div>
  </PageTitle>

  <article class="post-content">
    <Content />
  </article>

  {next && (
    <p class="read-next">
      <span class="label">{t.readNext}</span>
      <a href={url(`posts/${next.id}/`)}>{next.data.title}</a>
    </p>
  )}
</Base>
