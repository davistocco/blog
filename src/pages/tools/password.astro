---
import Base from '../../layouts/Base.astro';
import PageTitle from '../../components/PageTitle.astro';
import { url } from '../../lib/url';
import { PASSWORD_MIN, PASSWORD_MAX } from '../../lib/password';
---

<Base cover="images/capa-tools.jpg" coverAlt="Ferramentas penduradas numa parede de oficina (foto: Barn Images, Unsplash)" crumbs={[{ label: 'tools', href: url('tools/') }, { label: 'password' }]} title="Gerador de senha" description="Gere senhas aleatórias fortes, com o tamanho e os tipos de caractere que você escolher. Roda no navegador.">
  <PageTitle title="Gerador de senha" />

  <section class="tool">
    <form id="gen" class="tool-form">
      <label>Tamanho <input type="number" id="length" value="16" min={PASSWORD_MIN} max={PASSWORD_MAX} /></label>
      <label><input type="checkbox" id="lower" checked /> a-z</label>
      <label><input type="checkbox" id="upper" checked /> A-Z</label>
      <label><input type="checkbox" id="digits" checked /> 0-9</label>
      <label><input type="checkbox" id="symbols" checked /> !@#</label>
      <button type="submit">Gerar</button>
    </form>
    <div class="tool-field">
      <input type="text" id="result" class="tool-input" readonly aria-label="Senha gerada" />
      <button type="button" id="copy" class="copy">copiar</button>
    </div>
    <p class="tool-status" id="status" aria-live="polite"></p>
  </section>

  <script>
    import { generatePassword, passwordEntropy } from '../../lib/password';

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const result = $<HTMLInputElement>('result');
    const copy = $<HTMLButtonElement>('copy');
    const status = $<HTMLParagraphElement>('status');

    const generate = () => {
      const opts = {
        length: Number($<HTMLInputElement>('length').value) || 16,
        lower: $<HTMLInputElement>('lower').checked,
        upper: $<HTMLInputElement>('upper').checked,
        digits: $<HTMLInputElement>('digits').checked,
        symbols: $<HTMLInputElement>('symbols').checked,
      };
      status.className = 'tool-status';
      copy.textContent = 'copiar';
      if (!opts.lower && !opts.upper && !opts.digits && !opts.symbols) {
        result.value = '';
        status.textContent = 'Selecione ao menos um tipo de caractere';
        status.classList.add('bad');
        return;
      }
      result.value = generatePassword(opts);
      const bits = passwordEntropy({ ...opts, length: result.value.length });
      const [label, cls] = bits >= 80 ? ['Forte', 'ok'] : bits >= 50 ? ['Média', 'warn'] : ['Fraca', 'bad'];
      status.textContent = label;
      status.classList.add(cls);
    };

    $('gen').addEventListener('submit', (e) => { e.preventDefault(); generate(); });
    copy.addEventListener('click', async () => {
      if (!result.value) return;
      try {
        await navigator.clipboard.writeText(result.value);
        copy.textContent = 'copiado!';
      } catch {
        copy.textContent = 'erro';
      }
    });

    generate();
  </script>
</Base>
