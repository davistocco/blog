---
import { url } from '../lib/url';

interface Props {
  // Path under public/ (e.g. 'images/capa.jpg'); falls back to the site-wide cover.
  src?: string;
  alt?: string;
}

const {
  src = 'images/capa-home.svg',
  alt = 'Paisagem com montanhas e um lago ao pôr do sol',
} = Astro.props;
---

<div class="cover">
  <img src={url(src)} alt={alt} loading="eager" />
</div>
