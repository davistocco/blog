---
import { url } from '../lib/url';

interface Props {
  // Path under public/ (e.g. 'images/capa.jpg'); falls back to the site-wide cover.
  src?: string;
  alt?: string;
}

const {
  src = 'images/capa-home.jpg',
  alt = 'Montanha refletida num lago ao entardecer (foto: Azhar J, Unsplash)',
} = Astro.props;
---

<div class="cover">
  <img src={url(src)} alt={alt} loading="eager" />
</div>
