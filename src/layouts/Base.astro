---
import '@fontsource-variable/figtree';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import type { Lang } from '../lib/i18n';
import figtreeLatin from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import { url } from '../lib/url';
import Cover from '../components/Cover.astro';

interface Props {
  // Per-page cover (path under public/); omit for the site-wide one, false for none.
  cover?: string | false;
  coverAlt?: string;
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  lang?: Lang;
  // Trail after the site name; the last item is the current page (no href).
  crumbs?: { label: string; href?: string }[];
}

const {
  title,
  description = 'Blog do Davi Stocco',
  type = 'website',
  lang = 'pt-br',
  crumbs = [],
  cover,
  coverAlt,
} = Astro.props;

const fullTitle = title ? `${title} | Davi Stocco` : 'Davi Stocco';
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(url('images/very-young-davi.png'), Astro.site);
const year = new Date().getFullYear();
const isHome = Astro.url.pathname.replace(/\/$/, '') === url().replace(/\/$/, '');
const trail = [{ label: 'davistocco', href: url() }, ...crumbs];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="preload" href={figtreeLatin} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.ico')} />
    <link rel="alternate" type="application/rss+xml" title="Davi Stocco" href={url('rss.xml')} />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Davi Stocco" />
    <meta property="og:title" content={title ?? 'Davi Stocco'} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'pt_BR'} />
    <meta name="twitter:card" content="summary" />

    <script is:inline>
      // Runs before paint so a saved theme never flashes the other one.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <div class="wrapper">
      <main>
        <nav class="menu">
          <ol class="crumbs" aria-label="Breadcrumb">
            {trail.map((crumb, i) => (
              <li>
                {crumb.href && !(i === trail.length - 1 && (i > 0 || isHome))
                  ? <a href={crumb.href}>{crumb.label}</a>
                  : <span aria-current="page">{crumb.label}</span>}
              </li>
            ))}
          </ol>
          <button class="theme-toggle" type="button" id="theme-toggle" aria-label="Mudar tema">
            <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
          </button>
        </nav>
        {cover !== false && <Cover src={cover} alt={coverAlt} />}
        <slot />
      </main>

      <footer>
        <p>© 2023–{year} <a href={url()}>Davi Stocco</a></p>
        <ul>
          <li><a href={url('tools/')}>tools</a></li>
          <li><a href={url('rss.xml')}>rss</a></li>
          <li><a href="https://linkedin.com/in/davistocco">linkedin</a></li>
          <li><a href="https://github.com/davistocco">github</a></li>
        </ul>
      </footer>
    </div>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const button = document.getElementById('theme-toggle');
        const systemLight = matchMedia('(prefers-color-scheme: light)');
        const current = () => root.dataset.theme ?? (systemLight.matches ? 'light' : 'dark');

        const render = () => {
          const next = current() === 'dark' ? 'claro' : 'escuro';
          button.dataset.current = current();
          button.setAttribute('aria-label', `Mudar para o tema ${next}`);
          button.title = `Tema ${next}`;
        };

        button.addEventListener('click', () => {
          root.dataset.theme = current() === 'dark' ? 'light' : 'dark';
          try { localStorage.setItem('theme', root.dataset.theme); } catch {}
          render();
        });
        systemLight.addEventListener('change', render);
        render();
      })();
    </script>

    <script is:inline>
      document.querySelectorAll('.code-window .copy').forEach((button) => {
        button.addEventListener('click', async () => {
          const code = button.closest('.code-window').querySelector('pre').innerText;
          try {
            await navigator.clipboard.writeText(code);
            button.textContent = 'copiado!';
          } catch {
            button.textContent = 'erro';
          }
          setTimeout(() => (button.textContent = 'copiar'), 1500);
        });
      });
    </script>
  </body>
</html>
